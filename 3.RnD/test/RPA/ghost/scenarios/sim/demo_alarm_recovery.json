{
  "ghost": 1,
  "name": "demo_alarm_recovery",
  "description": "레시피 미선택 START → 알람 발생 → 하위 시나리오로 알람 확인 → 레시피 선택 후 재실행",
  "steps": [
    { "action": "click", "target": "nav_run" },
    { "action": "click", "target": "start_btn", "label": "레시피 없이 시작(알람 유발)" },
    { "action": "call", "scenario": "ack_alarm" },
    { "action": "click", "target": "nav_recipe" },
    { "action": "click", "target": "rcp_a" },
    { "action": "click", "target": "nav_run" },
    { "action": "click", "target": "start_btn", "expect": { "visible": "status_running", "timeout": 3 } },
    { "action": "wait_for", "target": "status_done", "timeout": 15 }
  ]
}
