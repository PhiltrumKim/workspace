{
  "ghost": 1,
  "name": "xnote_measure",
  "description": "장비형 시나리오(XNote Stopwatch): 실행 → 평가판 팝업 자동 처리 → 측정 시작/정지 → 결과 수치 판독·범위 검사 → 리셋 확인 → 종료",
  "watch": "watch_xnote.json",
  "on_abort": "xn_safe_close",
  "steps": [
    { "action": "hotkey", "keys": ["win", "r"], "label": "실행 창",
      "expect": { "visible": "run_prompt", "timeout": 3 }, "retry": 1 },
    { "action": "type", "text": "%USERPROFILE%\\Desktop\\XNote Stopwatch\\xnsw.exe" },
    { "action": "key", "key": "enter", "label": "스톱워치 실행",
      "expect": { "visible": "xn_display", "timeout": 10 } },
    { "action": "wait_gone", "target": "xn_nag_title", "timeout": 8, "label": "평가판 팝업 처리 대기" },

    { "action": "right_click", "target": "xn_display", "label": "메뉴",
      "expect": { "visible": "menu_start", "timeout": 3 }, "retry": 1 },
    { "action": "click", "target": "menu_start", "label": "측정 시작",
      "expect": { "gone": "menu_start", "timeout": 3 } },
    { "action": "wait", "sec": 5, "label": "측정 중" },
    { "action": "right_click", "target": "xn_display",
      "expect": { "visible": "menu_stop", "timeout": 3 }, "retry": 1 },
    { "action": "click", "target": "menu_stop", "label": "측정 정지",
      "expect": { "gone": "menu_stop", "timeout": 3 } },
    { "action": "move", "x": 1300, "y": 600, "label": "커서를 표시창 밖으로" },
    { "action": "read", "name": "elapsed_s", "region": [1140, 20, 770, 240], "vote": true,
      "pattern": "^00:00:(\\d\\d\\.\\d\\d)$", "min": 5.0, "max": 20.0,
      "label": "경과 시간 판독 (대기 5s + 메뉴 조작·확인 시간 포함, 실측 ~11s)" },

    { "action": "right_click", "target": "xn_display",
      "expect": { "visible": "menu_reset", "timeout": 3 }, "retry": 1 },
    { "action": "click", "target": "menu_reset", "label": "리셋",
      "expect": { "gone": "menu_reset", "timeout": 3 } },
    { "action": "move", "x": 1300, "y": 600 },
    { "action": "read", "name": "after_reset", "region": [1140, 20, 770, 240], "vote": true,
      "pattern": "^00:00:00\\.00$", "label": "리셋 확인" },

    { "action": "call", "scenario": "xn_safe_close", "label": "종료" }
  ]
}
