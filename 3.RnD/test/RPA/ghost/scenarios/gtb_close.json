{
  "ghost": 1,
  "name": "gtb_close",
  "description": "GTB-3000 종료: 열린 확인 창 닫기 → 창이 남아 있는 동안 (제목줄 초점 → Alt+F4 → 종료 확인 '예') 반복",
  "steps": [
    {
      "action": "key",
      "key": "esc",
      "label": "열린 확인 창이 있으면 닫기"
    },
    {
      "action": "while",
      "cond": {
        "visible": {
          "text": "GTB-3000 Analyzer"
        }
      },
      "max": 3,
      "label": "GTB-3000 이 떠 있는 동안",
      "steps": [
        {
          "action": "click",
          "target": {
            "text": "GTB-3000 Analyzer"
          },
          "timeout": 10,
          "label": "제목줄에 초점"
        },
        {
          "action": "hotkey",
          "keys": [
            "alt",
            "f4"
          ]
        },
        {
          "action": "wait",
          "sec": 1.5
        },
        {
          "action": "if",
          "cond": {
            "visible": {
              "text": "종료"
            },
            "timeout": 3
          },
          "label": "종료 확인 창이 뜨면",
          "then": [
            {
              "action": "key",
              "key": "y",
              "label": "'예'"
            }
          ]
        },
        {
          "action": "wait",
          "sec": 2
        }
      ]
    },
    {
      "action": "wait_gone",
      "target": {
        "text": "GTB-3000 Analyzer"
      },
      "timeout": 15
    }
  ]
}
